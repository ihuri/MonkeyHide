{
  "manifest_version": 3,
  "name": "MonkeyHide",
  "version": "1.2.0",
  "description": "Selecione e esconda elementos indesejados de qualquer site de forma permanente.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MonkeyHide",
    "default_icon": {
      "16": "icons/icon_smile_16.png",
      "32": "icons/icon_smile_32.png",
      "48": "icons/icon_smile_48.png",
      "128": "icons/icon_smile_128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
